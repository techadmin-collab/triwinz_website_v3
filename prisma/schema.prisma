generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Blog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  slug       String   @unique
  content    String
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  seoTitle   String?
  seoDesc    String?
  createdAt  DateTime @default(now())
}

model CaseStudy {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  slug       String   @unique
  content    String
  summary    String
  coverImage String?
  client     String?
  industry   String?
  result     String?
  published  Boolean  @default(false)
  seoTitle   String?
  seoDesc    String?
  createdAt  DateTime @default(now())
}

model Job {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String   @unique
  department       String
  location         String
  type             String   // Employment | Contract | Internship (multi: "Employment / Contract")
  workMode         String   @default("Hybrid") // WFH | WFO | Hybrid
  experience       String
  joiningPeriod    String   @default("") // e.g. Immediate, 15 days, 30 days, 60 days
  summary          String
  about            String
  responsibilities String[]
  requirements     String[]
  qualifications   String[] @default([])
  niceToHave       String[]
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model JobApplication {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  jobSlug        String
  jobTitle       String
  fullName       String
  email          String
  phone          String
  coverLetter                 String?
  referralSource              String?
  availableToJoinAndRelocate  Boolean?
  resumeUrl                   String
  resumePublicId String?
  resumeFileName String?
  status         String   @default("new") // new | shortlisted | on_hold | rejected | selected
  hiringTerms    String?  // terms entered when the candidate is hired (Interviews)
  hiredAt        DateTime?
  createdAt      DateTime @default(now())

  @@index([jobSlug])
  @@index([status])
  @@index([createdAt])
}

model TrainingApplication {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName       String
  email          String
  phone          String
  qualification  String
  college        String
  yearOfPassing  String
  resumeUrl      String?
  resumePublicId String?
  resumeFileName String?
  status         String   @default("new") // new | contacted | enrolled | rejected
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  fullName   String
  email      String
  phone      String
  company    String
  message    String
  emailSent  Boolean  @default(false)
  emailError String?
  status     String   @default("new") // new | read | archived
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([emailSent])
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         String // admin | staff
  permissions  String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model TeamMember {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  role          String
  bio           String[] // one entry per paragraph
  photoUrl      String?
  photoPublicId String?  // Cloudinary id, so the photo can be deleted with the member
  linkedin      String?
  order         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published])
  @@index([order])
}

// External interviewers (no admin login). Results are recorded by the admin team.
model Interviewer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  phone       String?
  company     String?
  designation String?
  notes       String?
  active      Boolean  @default(true)
  // Private availability link (no login): /panel/<portalToken>
  portalToken     String?
  portalCreatedAt DateTime?
  portalSentAt    DateTime?
  portalSeenAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([portalToken])
}

// Times a panel member says they're free, entered from their private link.
// date is the calendar day (YYYY-MM-DD) and minutes are from midnight, India time (IST).
model InterviewerSlot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  interviewerId String   @db.ObjectId
  date          String
  startMin      Int
  endMin        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([interviewerId, date])
  @@index([date])
}

// One interview level (round) for a job application: Level 1, Level 2, ...
model InterviewRound {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  applicationId    String    @db.ObjectId
  jobSlug          String
  level            Int
  title            String?   // optional name, e.g. Technical, HR
  interviewerIds   String[]  @db.ObjectId
  interviewerNames String[]  // copy of the names, kept even if an interviewer is removed
  scheduledAt      DateTime?
  mode             String?   // online | in_person | phone
  location         String?   // meeting link or address
  notes            String?
  status           String    @default("scheduled") // scheduled | passed | rejected | on_hold | cancelled
  feedback         String?
  rating           Int?      // 1-5
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([applicationId])
  @@index([status])
  @@index([jobSlug])
  @@index([scheduledAt])
}

// Problems users hit on the public site (captcha, resume upload, saving, emails).
// One row per kind of problem; repeats only bump the count. Shown in Admin -> System issues.
model SystemIssue {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  fingerprint    String    @unique // source:code, e.g. "job-application:resume_upload_failed"
  source         String    // job-application | training-application | contact
  code           String
  severity       String    @default("error") // error | warning
  title          String
  message        String?   // latest technical message
  recent         String[]  // last few occurrences (JSON text), newest first
  count          Int       @default(1)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([resolved, lastSeenAt])
}
